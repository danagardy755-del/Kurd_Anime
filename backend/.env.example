NODE_ENV=production
HOST=0.0.0.0
PORT=8787
CORS_ORIGIN=https://your-app-domain.example
ANILIST_URL=https://graphql.anilist.co
JIKAN_URL=https://api.jikan.moe/v4
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_SSL=true

# Primary Kurd Anime source: only media you own or are licensed to distribute
KURD_ANIME_CDN_NAME=Kurd Anime Licensed CDN
KURD_ANIME_CDN_BASE_URL=
KURD_ANIME_CDN_TEMPLATE={animeId}/{episode}.m3u8

# Anime provider integrations: enable only after you have the required partner/licensing access
CRUNCHYROLL_PARTNER_ENABLED=false
CRUNCHYROLL_PARTNER_BASE_URL=https://www.crunchyroll.com/
HIDIVE_PARTNER_ENABLED=false
HIDIVE_PARTNER_BASE_URL=https://www.hidive.com/
